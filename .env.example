# This template is tracked in Git. start.cmd creates .env from it on first run.
# Open .env and replace the placeholder below with YOUR key.
# Never commit .env or share real credentials.
# External API calls happen ONLY after explicit consent to AI renaming.
PDF_MERGER_API_KEY=insert your key here

# Default OpenAI-compatible model. Change only if your API provider requires it.
PDF_MERGER_AI_MODEL=gpt-4o-mini
PDF_MERGER_API_URL=https://api.openai.com/v1/chat/completions
