# Never put patient PDF files, raw scans or generated output in git.
*.pdf
*.PDF
/input/*
/output/*
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.tmp
.DS_Store
# API credentials belong only in ignored local environment files.
.env
.env.*
!.env.example

# Local AI diagnostic progress (no secrets or PDF excerpts).
/logs/

# Isolated CPU-only Surya OCR pilot (models, binaries, OCR test output are local).
/.venv-surya-cpu/
/.local-tools/
